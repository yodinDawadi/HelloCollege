# Server
PORT=5000
NODE_ENV=development

# MongoDB (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus_complaints?retryWrites=true&w=majority

# Firebase Admin SDK
# Download the service account JSON from:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Then either:
#  1) put the file at ./config/serviceAccountKey.json (gitignored), OR
#  2) paste the JSON as a single-line string below
FIREBASE_SERVICE_ACCOUNT=

# CORS
CLIENT_ORIGIN=*
